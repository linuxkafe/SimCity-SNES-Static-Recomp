# SimCity SNES Static Recomp - Linux Simple Build
# Simplifies compilation for Steam Deck and Linux systems

CC = gcc
CFLAGS = -Wall -Wextra -O2 -std=c11
LDFLAGS = -lSDL2

BUILD_DIR = build/linux-frontend
SRC_DIR = frontend/linux
CORE_DIR = static-recomp

all: $(BUILD_DIR)/simcity-linux

$(BUILD_DIR):
	@mkdir -p $(BUILD_DIR)

$(BUILD_DIR)/simcity-linux: $(BUILD_DIR) $(SRC_DIR)/main.c $(CORE_DIR)/include/simcity_static_recomp.h
	$(CC) $(CFLAGS) -I$(CORE_DIR)/include -I$(CORE_DIR)/internal/include $(SRC_DIR)/main.c -L$(BUILD_DIR)/.. -lsimcity-static-recomp $(LDFLAGS) -o $@

clean:
	@rm -rf $(BUILD_DIR)

.PHONY: all clean
